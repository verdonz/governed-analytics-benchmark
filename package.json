{
  "name": "governed-analytics-benchmark",
  "version": "26.10.0",
  "description": "A reproducible benchmark for governed AI analytics agents.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:setup": "tsx scripts/setup.ts",
    "gold:validate": "tsx scripts/validate-gold.ts",
    "benchmark:export": "tsx scripts/run-benchmark.ts export",
    "benchmark:evaluate": "tsx scripts/run-benchmark.ts evaluate",
    "report": "tsx scripts/generate-report.ts",
    "validate": "npm run lint && npm run typecheck && npm test && npm run data:setup && npm run gold:validate && npm run build"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
